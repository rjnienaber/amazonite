private alias {{ service.module_alias }} = {{ service.module_name }}
private alias Core = Amazonite::Core

module {{ service.module_name }}
  class Client < Core::Client
    Log {% if operations.has_errors %}              {% endif %}= ::Log.for("amazonite.{{ service.lower_name }}_{{ service.lower_version }}.client")
{% if operations.has_errors %}    EXCEPTION_FACTORY = ExceptionFactory.new
{% endif %}
    def initialize(config = Core::Config.new)
      super("{{ operations.target_prefix }}", "{{ operations.endpoint_prefix }}", "{{ operations.json_version }}", {% if operations.has_errors %}EXCEPTION_FACTORY, {% else %}nil, {% endif %}config)
    end{% for operation in operations.operations %}

{% if operation.has_doc %}{{ operation.doc }}
{% endif %}    def {{ operation.function_name }}{% if operation.has_input %}(input : {{ operation.input }}){% endif %} : {{ operation.output }}
      Log.info { "performing '{{ operation.command }}' operation" }
{% if operation.has_input -%}
      input.validate! if config.validate_input?
{% endif -%}
{% if operation.is_rest -%}
      path = {{ operation.path_literal }}
{% if operation.has_query -%}
      query = URI::Params.build do |form|
{% for query_add in operation.query_adds -%}
{% if query_add.is_list -%}
        ({{ query_add.list_accessor }} || [] of {{ query_add.list_item_type }}).each do |value|
          form.add("{{ query_add.wire_name }}", {{ query_add.item_expr }})
        end
{% else -%}
        if value = {{ query_add.value_expr }}
          form.add("{{ query_add.wire_name }}", value)
        end
{% endif -%}
{% endfor -%}
      end
      path = "#{path}?#{query}" unless query.empty?
{% endif -%}
      headers = HTTP::Headers.new
{% for header in operation.request_headers -%}
{% if header.is_list -%}
      ({{ header.list_accessor }} || [] of {{ header.list_item_type }}).each do |value|
        headers.add("{{ header.wire_name }}", {{ header.item_expr }})
      end
{% else -%}
      if value = {{ header.value_expr }}
        headers["{{ header.wire_name }}"] = value
      end
{% endif -%}
{% endfor -%}
      response = rest_request("{{ operation.command }}", "{{ operation.http_method }}", path, headers, {{ operation.body_expr }})
{% if operation.custom_output -%}
      result = {{ operation.output_type }}.new({% for assignment in operation.output_assignments %}
        {{ assignment.name }}: {{ assignment.value_expr }},{% endfor %}
      )
      {{ operation.output }}.new(response, result)
{% else -%}
      {{ operation.output }}.new(response)
{% endif -%}
{% elif operation.is_query -%}
{% if operation.has_input -%}
      params = input.to_query_params("")
{% else -%}
      params = [] of {String, String}
{% endif -%}
      body = URI::Params.build do |form|
        form.add("Action", "{{ operation.command }}")
        form.add("Version", "{{ operations.api_version }}")
        params.each { |key, value| form.add(key, value) }
      end
      response = query_request("{{ operation.command }}", body)
{% if operation.no_output -%}
      {{ operation.output }}.new(response)
{% else -%}
      result_node = XML.parse(response.body).xpath_node("//*[local-name()='{{ operation.result_element }}']").not_nil!
      result = {{ operation.output_type_bare }}.from_xml(result_node)
      {{ operation.output }}.new(response, result)
{% endif -%}
{% else -%}
      response = post("{{ operation.command }}", "/", input.to_json)
      {{ operation.output }}.new(response)
{% endif -%}
    end{% endfor %}
  end
end
