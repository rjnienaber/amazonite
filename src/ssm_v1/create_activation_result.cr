private alias Core = Amazonite::Core

module Amazonite::SsmV1
  class CreateActivationResult
    include JSON::Serializable

    # The ID number generated by the system when it processed the activation. The activation ID
    # functions like a user name.
    @[JSON::Field(key: "ActivationId")]
    property activation_id : String | Nil

    # The code the system generates when it processes the activation. The activation code functions
    # like a password to validate the activation ID.
    @[JSON::Field(key: "ActivationCode")]
    property activation_code : String | Nil

    def initialize(
      @activation_id : String | Nil = nil,
      @activation_code : String | Nil = nil,
    )
    end

    def validate! : Nil
      if value = @activation_id
        raise Core::ValidationError.new("ActivationId does not match the required pattern") unless value.matches?(Regex.new("^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"))
      end

      if value = @activation_code
        raise Core::ValidationError.new("ActivationCode length must be >= 20") if value.size < 20
        raise Core::ValidationError.new("ActivationCode length must be <= 250") if value.size > 250
      end
    end

    def_equals_and_hash(@activation_id, @activation_code)
  end
end
